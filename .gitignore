
# --- Spazz Project Standard Gitignore ---

# 1. Private Secrets (Crucial)
.env
.envrc
*.log
.env.txt
.env*

# 2. Python Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
dist/
*.egg-info/

# 3. Development Tools
.vscode/
.idea/
.DS_Store
Thumbs.db
.history/

# 4. Testing & Coverage
.tox/
.coverage
.pytest_cache/
nosetests.xml
coverage.xml
htmlcov/

# 5. Database (Local)
*.sqlite3
db.sqlite3-journal
users_db.json

# 6. CI/CD & Security (GitHub Actions leftovers)
.github/agents/
*.manifest
*.spec
# test from my PC

# 7. Privacy Geofencing & Spatial Data (New)
# Blocks local testing boundaries, geofence shapes, and spatial calculation caches
.geofence_cache/
*geofence*.json
*coords*.tmp
spatial_index.bak

# 8. Flutter & Dart
.dart_tool/



# 9. Node.js Dependencies
node_modules/



# 10. Flutter Generated Plugin Files
.flutter-plugins
.flutter-plugins-dependencies



# 11. Flutter Build & iOS/Android Artifacts
ios/Flutter/.last_build_id
android/app/debug/
android/app/profile/
android/app/release/

# Vercel
.vercel/

# Android Gradle Cache
android/.gradle/